{
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "cosmosDbCollectionId": {
            "type": "string"
        },
        "cosmosDbDatabaseId": {
            "type": "string"
        },
        "CosmosDbEndpoint": {
            "type": "string"
        },
        "environmentName": {
            "type": "string"
        },
        "functionAppNames": {
            "type": "array"
        },
        "serviceBusQueueName": {
            "type": "string"
        },
        "sharedAppServicePlanName": {
            "type": "string"
        },
        "sharedAppServicePlanResourceGroup": {
            "type": "string"
        },
        "storageAccountName": {
            "type": "string"
        },
        "storageAccountKey": {
            "type": "securestring"
        },
        "templateBaseUrl": {
            "type": "string"
        },
        "workspaceName": {
            "type": "string"
        },
        "workspaceResourceGroup": {
            "type": "string"
        },
        "appInsightsInstrumentationKey": {
            "type": "string"
        },
        "keyVaultName": {
            "type": "string"
        }
    },
    "resources": [
        {
            "type": "Microsoft.Web/sites/config",
            "apiVersion": "2023-12-01",
            "name": "[format('{0}/{1}', parameters('functionAppNames')[copyIndex()], 'appsettings')]",
            "properties": {
                "EnvironmentName": "[toUpper(parameters('environmentName'))]",
                "FUNCTIONS_EXTENSION_VERSION": "~4",
                "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
                "MSDEPLOY_RENAME_LOCKED_FILES": "1",
                "AzureWebJobStorage": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=SharedStorageAccountConnectionString)', parameters('keyVaultName'))]",
                "APPINSIGHTS_INSTRUMENTATIONKEY": "[parameters('appInsightsInstrumentationKey')]",
                "CollectionId": "[parameters('cosmosDbCollectionId')]",
                "DatabaseId": "[parameters('cosmosDbDatabaseId')]",
                "CustomerDatabaseId": "customers",
                "CustomerCollectionId": "customers",
                "InteractionDatabaseId": "interactions",
                "InteractionCollectionId": "interactions",
                "ServiceBusConnectionString": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=ServiceBusConnectionString)', parameters('keyVaultName'))]",
                "QueueName": "[parameters('serviceBusQueueName')]",
                "AzureCountrySet": "GB",
                "CosmosDbEndpoint": "[parameters('CosmosDbEndpoint')]"
				"OSServiceApiUrl": "https://api.os.uk/search/places/v1/postcode?postcode={0}&dataset=DPA&output_srs=WGS84",
				"OSServiceApiKey": "[format('@Microsoft.KeyVault(VaultName={0};SecretName=GetPostCodeApiKey)', parameters('keyVaultName'))]"
            },
            "copy": {
                "name": "FunctionAppSettingsCopy",
                "count": "[length(parameters('functionAppNames'))]"
            }
        },
        {
            "type": "Microsoft.Web/sites/config",
            "apiVersion": "2023-12-01",
            "name": "[format('{0}/{1}', parameters('functionAppNames')[copyIndex()], 'connectionstrings')]",
            "properties": {},
            "copy": {
                "name": "FunctionConnectionStringsCopy",
                "count": "[length(parameters('functionAppNames'))]"
            }
        }
    ],
    "outputs": {}
}